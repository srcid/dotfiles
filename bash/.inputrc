## arrow up
"\e[A": history-search-backward

## arrow down
"\e[B": history-search-forward

# case insensitive search
set completion-ignore-case on

## Menu complete
TAB: menu-complete
"\e[Z": menu-complete-backward
set menu-complete-display-prefix on
set show-all-if-unmodified on
set show-all-if-ambiguous on
set colored-completion-prefix on
set colored-stats on

# ctrl + Backspace for delete word backward
"\C-H": backward-kill-word

# Alt + d for delete whole word from begining
"\ed": kill-word

# disable more pagger on long completions, just print it out
set page-completions off

# Sets the threshold for how many items will trigger a "show all matches?" confirmation prompt
# -1 show all matches without asking
# set completion-query-items -1
